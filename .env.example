# Variables d'environnement DataShare — copier vers .env (non versionné)
# cp .env.example .env  puis éditer les valeurs

# ── Base de données ───────────────────────────────────────────────────────────
POSTGRES_DB=datashare
POSTGRES_USER=datashare
# Générer avec : openssl rand -base64 24
POSTGRES_PASSWORD=change_me_strong_password

# ── Backend Spring Boot ───────────────────────────────────────────────────────
DATASHARE_DB_URL=jdbc:postgresql://postgres:5432/datashare
DATASHARE_DB_USER=datashare
DATASHARE_DB_PASSWORD=change_me_strong_password
DATASHARE_DB_POOL_SIZE=20

# JWT — générer avec : openssl rand -base64 48
DATASHARE_JWT_SECRET=change_me_at_least_32_chars_secret_key_here

# CORS — URL publique du frontend (ex: https://datashare.example.com)
DATASHARE_CORS_ORIGINS=http://localhost:8080

# Stockage des fichiers uploadés (monté en volume Docker)
DATASHARE_STORAGE_PATH=/app/uploads