# Variables d'environnement DataShare — copier vers .env (non versionné)

# Profil Spring (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# JWT — IMPÉRATIF de remplacer en production (32+ caractères)
DATASHARE_JWT_SECRET=change-me-32-chars-minimum-please-rotate-regularly

# Stockage local des fichiers
DATASHARE_STORAGE_PATH=./uploads

# CORS — origine du front
DATASHARE_CORS_ORIGINS=http://localhost:4200

# BDD (production)
# DATASHARE_DB_URL=jdbc:postgresql://db.example:5432/datashare
# DATASHARE_DB_USER=datashare
# DATASHARE_DB_PASSWORD=...
