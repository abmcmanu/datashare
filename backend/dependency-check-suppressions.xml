<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!--
        CVE-2025-48924 — Faux positif commons-lang3
        Le CPE NVD (apache:commons_lang) cible commons-lang 1.x/2.x (EOL depuis 2011).
        commons-lang3 est un projet distinct (org.apache.commons:commons-lang3) non affecté.
    -->
    <suppress>
        <notes>CVE-2025-48924 : faux positif CPE — cible commons-lang 2.x (EOL), pas commons-lang3.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons\-lang3@.*$</packageUrl>
        <cve>CVE-2025-48924</cve>
    </suppress>

    <!--
        CVE-2025-7962 — Faux positif angus-activation
        Le CPE NVD (eclipse:angus_mail) cible Angus Mail (implémentation Jakarta Mail).
        Ce JAR est angus-activation (implémentation Jakarta Activation), un sous-projet
        distinct dans le projet Eclipse Angus. L'artefact concerné par le CVE est
        org.eclipse.angus:angus-mail, pas org.eclipse.angus:angus-activation.
    -->
    <suppress>
        <notes>CVE-2025-7962 : faux positif CPE — cible angus-mail, pas angus-activation.
               Deux sous-projets distincts dans Eclipse Angus.</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus\-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

    <!--
        CVE-2025-15104 — hibernate-validator 8.0.3.Final
        Aucune version corrigée disponible (8.0.3.Final est la dernière release 8.x).
        L'exploitation requiert une configuration de validation spécifique non présente
        dans ce projet (validation de contraintes personnalisées via EL expressions).
        À réévaluer lors de la sortie d'une version corrigée.
    -->
    <suppress>
        <notes>CVE-2025-15104 : aucun patch disponible pour hibernate-validator 8.x.
               Non exploitable avec la configuration de validation standard de ce projet.</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate\-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!--
        CVEs log4j-api (CVE-2026-34478, CVE-2026-34480, CVE-2026-34481, CVE-2025-68161)
        Spring Boot inclut uniquement log4j-api (la façade/API), jamais log4j-core
        (l'implémentation). Le logger actif est Logback via SLF4J ; log4j-to-slf4j
        redirige les appels log4j vers SLF4J sans activer log4j-core.
        Les CVEs historiques log4j (dont Log4Shell) n'affectent que log4j-core.
        Ces CVEs sont non exploitables sans log4j-core dans le classpath.
    -->
    <suppress>
        <notes>log4j-api seulement : log4j-core absent du classpath. CVEs non exploitables.</notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j\-api@.*$</packageUrl>
        <cve>CVE-2026-34478</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j\-api@.*$</packageUrl>
        <cve>CVE-2026-34480</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j\-api@.*$</packageUrl>
        <cve>CVE-2026-34481</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j\-api@.*$</packageUrl>
        <cve>CVE-2025-68161</cve>
    </suppress>

    <!--
        CVEs DOMPurify dans swagger-ui (bundle JS embarqué)
        swagger-ui embarque DOMPurify pour le rendu de la documentation OpenAPI générée
        par le code de l'application. Aucun contenu HTML fourni par l'utilisateur final
        n'est traité par cette interface. L'exploitation requiert qu'un attaquant contrôle
        à la fois ADD_TAGS et FORBID_TAGS simultanément dans la config DOMPurify,
        ce qui est impossible depuis l'extérieur sur une doc API statique.
    -->
    <suppress>
        <notes>DOMPurify dans swagger-ui : doc API statique, aucun HTML utilisateur traité.
               Non exploitable dans ce contexte.</notes>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2026-41240</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2026-41238</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <cve>CVE-2026-41239</cve>
    </suppress>
    <suppress>
        <packageUrl regex="true">^pkg:javascript/DOMPurify@.*$</packageUrl>
        <vulnerabilityName>GHSA-39q2-94rc-95cp</vulnerabilityName>
    </suppress>

</suppressions>
